# Server-only secrets. Copy to server/.env and fill in values.
PORT=3001

# OpenAI label analysis
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_PROMPT_VERSION=wellumi_label_summary_v1

# Supabase (service role — never expose to Expo)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# External product data
USDA_FDC_API_KEY=your_usda_fdc_api_key_here

# Optional tuning
SCAN_IMAGE_BUCKET=scan-images
