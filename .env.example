# Expo publishable configuration only. Copy to .env for local development.
# Never put service role, OpenAI, or USDA keys in the Expo app.

EXPO_PUBLIC_API_BASE_URL=http://192.168.1.25:3001
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
